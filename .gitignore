# 当前 Git 仓库只同步 CTFLab 本身；同目录中的课程题库、成绩表、报告和缓存不入库。
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/LICENSE
!/docs/
!/tools/

/docs/*
!/docs/ctflab-mac-mvp-implementation-plan.md
!/docs/ctflab-phase1-quickstart.md
!/docs/ctflab-dynamic-resolution-design.md
!/docs/verification-2026-09-06.md
!/docs/verification-2026-09-07.md
!/docs/verification-2026-09-13.md
!/docs/verification-2026-09-14.md
!/docs/verification-utm-smoke-2026-09-14.md
!/docs/verification-utm-basic-pentesting-2-2026-09-14.md
!/docs/ctflab-task6-packaging-design.md
!/docs/ctflab-distribution-guide.md
!/docs/verification-task6-1-2026-09-15.md
!/docs/ctflab-task6-app-runtime-design.md
!/docs/verification-task6-2-2026-09-15.md
!/docs/verification-task6-3a-2026-09-15.md
!/docs/verification-task6-3b-2026-09-15.md
!/docs/verification-distribution-2026-09-16.md

/tools/*
!/tools/ctflab
!/tools/ctflab.py
!/tools/ctflab_inspect.py
!/tools/ctflab_network.py
!/tools/ctflab_utm.py
!/tools/ctflab_package.py
!/tools/ctflab_acceptance.py
