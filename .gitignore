!/tools/guest_fixes/kali-arm64/kali.sources
!/tools/guest_fixes/kali-arm64/ghidra_help_fix.py
/tools/guest_fixes/basic-pentesting-2/*
!/tools/guest_fixes/basic-pentesting-2/interfaces
/tools/guest_fixes/smoke/*
!/tools/guest_fixes/smoke/interfaces
/tools/tests/*
!/tools/tests/*.py

# 即使以后调整白名单，也绝不提交虚拟磁盘、运行状态或本地凭据。
*.qcow2
*.vmdk
*.vdi
*.vhd
*.vhdx
*.raw
*.img
*.ova
*.utm/
*.ctflab
*.tar.gz
dist/
*.pyc
__pycache__/
.DS_Store
.env
.env.*
*.pem
*.key
runtime/
logs/
probes/
