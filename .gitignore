!/tools/ctflab_dist.py
!/tools/ctflab_app_e2e.py
!/tools/ctflab_app_kali_e2e.py
!/tools/ctflab_utm_fixture.json
!/tools/ctflab_profiles/
!/tools/guest_fixes/
!/tools/licenses/
!/tools/tests/

# vendored 许可证文本：只允许明确登记的组件目录与文件（默认拒绝）。
/tools/licenses/*
!/tools/licenses/PROVENANCE.md
!/tools/licenses/dtc/
/tools/licenses/dtc/*
!/tools/licenses/dtc/GPL
!/tools/licenses/dtc/BSD-2-Clause
!/tools/licenses/dtc/README.license

/tools/ctflab_profiles/*
!/tools/ctflab_profiles/*.yaml
/tools/guest_fixes/*
!/tools/guest_fixes/basic-pentesting-2/
!/tools/guest_fixes/smoke/
!/tools/guest_fixes/kali-arm64/
/tools/guest_fixes/kali-arm64/*
