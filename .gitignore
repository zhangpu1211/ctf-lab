# 当前 Git 仓库只同步 CTFLab 本身；同目录中的课程题库、成绩表、报告和缓存不入库。
/*
!/.gitignore
!/README.md
!/docs/
!/tools/

/docs/*
!/docs/ctflab-mac-mvp-implementation-plan.md
!/docs/ctflab-phase1-quickstart.md
!/docs/verification-2026-09-06.md

/tools/*
!/tools/ctflab
!/tools/ctflab.py
!/tools/ctflab_inspect.py
!/tools/ctflab_network.py
!/tools/ctflab_profiles/
!/tools/guest_fixes/
!/tools/tests/

/tools/ctflab_profiles/*
!/tools/ctflab_profiles/*.yaml
/tools/guest_fixes/*
!/tools/guest_fixes/basic-pentesting-2/
!/tools/guest_fixes/smoke/
/tools/guest_fixes/basic-pentesting-2/*
!/tools/guest_fixes/basic-pentesting-2/interfaces
/tools/guest_fixes/smoke/*
!/tools/guest_fixes/smoke/interfaces
/tools/tests/*
!/tools/tests/*.py

# 即使以后调整白名单，也绝不提交虚拟磁盘、运行状态或本地凭据。
*.qcow2
*.vmdk
*.vdi
*.vhd
*.vhdx
*.raw
*.img
*.ova
*.utm/
*.pyc
__pycache__/
.DS_Store
.env
.env.*
*.pem
*.key
runtime/
logs/
probes/
